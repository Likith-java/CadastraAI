# --- add near your other imports in main.py ---
from vector_postprocess import clean_vector_output, to_geojson_str

# --- add near your other endpoints ---

@app.post("/aoi/{aoi_id}/vectorize/clean")
async def vectorize_clean(
    aoi_id: str,
    method: str = "frame_field",
    min_area_m2: float = 9.0,
    simplify_tolerance_m: float = 0.35,
    orthogonalize: bool = False,
):
    aoi = get_aoi_or_404(aoi_id)

    if method == "frame_field":
        raw_polygons = aoi.frame_field_polygons
    else:
        raw_polygons = aoi.watershed_polygons

    transform = aoi.geotransform
    src_crs = aoi.utm_crs or "EPSG:32643"

    gdf = clean_vector_output(
        raw_polygons,
        transform=transform,
        src_crs=src_crs,
        min_area_m2=min_area_m2,
        simplify_tolerance_m=simplify_tolerance_m,
        do_orthogonalize=orthogonalize,
    )

    return JSONResponse(content=json.loads(to_geojson_str(gdf)))
